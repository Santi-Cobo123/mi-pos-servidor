# Copia este archivo como ".env" si quieres cambiar algo (opcional).
PORT=3000
# Clave secreta de sesiones. Si no la pones, se genera sola en data/jwt.secret
# JWT_SECRET=pon-aqui-un-texto-largo-y-aleatorio
# Carpeta donde se guarda la base de datos (por defecto ./data)
# DATA_DIR=./data
# Cuando lo publiques en internet (con https):
# NODE_ENV=production
# TRUST_PROXY=1
